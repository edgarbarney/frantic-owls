{
	"mode": "phone",
	"command": "owl",
	"openKey": "up",
	"defaultLanguage": "en-GB",
	"backfillNumbers": true,
	"contacts": {
		"maxContacts": 250,
		"maxNameLength": 40
	},
	"messages": {
		"pageSize": 40,
		"maxChatsListed": 100,
		"rateLimitCount": 8,
		"rateLimitWindowMs": 5000
	},
	"notifications": {
		"toastDurationMs": 3000,
		"soundMode": "file",
		"sounds": [
			{
				"id": "hoot",
				"label": "Owl Hoot",
				"file": "Sounds/OwlHoot.wav"
			},
			{
				"id": "chime",
				"label": "Bell Chime",
				"file": "Sounds/BellChime.wav"
			},
			{
				"id": "sparkle",
				"label": "Wand Sparkle",
				"file": "Sounds/WandSparkle.wav"
			},
			{
				"id": "tap",
				"label": "Window Tap",
				"file": "Sounds/WindowTap.wav"
			},
			{
				"id": "quill",
				"label": "Quill Scratch",
				"file": "Sounds/QuillScratch.wav"
			},
			{
				"id": "harp",
				"label": "Enchanted Harp",
				"file": "Sounds/EnchantedHarp.wav"
			}
		],
		"defaultSound": "hoot",
		"wwiseEvent": "UI_OwlMail_Envelope_Open",
		"quietActivities": [
			"duel:standard"
		]
	},
	"storage": {
		"disableSoftDelete": false,
		"messageRetentionDays": 0
	},
	"flight": {
		"enabled": false,
		"minSeconds": 3,
		"maxSeconds": 45,
		"secondsPerHundredMetres": 3,
		"groupSeconds": 5
	},
	"announcements": {
		"enabled": true,
		"command": "owl_announce",
		"senderName": "Ministry of Magic",
		"avatarUrl": "",
		"capability": "admin.announce",
		"fallbackGroup": "admin",
		"fallbackMinimumGrade": 1,
		"maxLength": 1000
	},
	"logging": {
		"enabled": false,
		"destination": "",
		"url": "",
		"urlEnv": "FRANTIC_OWLS_WEBHOOK_URL",
		"username": "Owl Post",
		"includeBodies": false,
		"flushIntervalMs": 5000,
		"events": {
			"messages": true,
			"groups": true,
			"informs": true,
			"calls": true,
			"blocks": true,
			"announcements": true,
			"system": true
		}
	},
	"network": {
		"flushIntervalMs": 50,
		"nearbyRefreshMs": 1000,
		"requestTimeoutMs": 8000,
		"requestRateLimitCount": 30,
		"requestRateLimitWindowMs": 3000,
		"maxBatchBytes": 24000
	},
	"avatars": {
		"maxUrlLength": 512,
		"allowedHosts": [],
		"allowInsecure": false
	},
	"phonemode_numbers": {
		"visible": false,
		"dialling": false,
		"rateLimitCount": 10,
		"rateLimitWindowMs": 60000
	},
	"phonemode_messages": {
		"maxLength": 500,
		"unsendSeconds": 120,
		"maxPinnedChats": 5,
		"maxForwardTargets": 5
	},
	"phonemode_polls": {
		"enabled": true,
		"maxOptions": 10,
		"maxQuestionLength": 200,
		"maxOptionLength": 100
	},
	"phonemode_privacy": {
		"readReceipts": true,
		"typingIndicators": true
	},
	"phonemode_groups": {
		"maxMembers": 12,
		"maxTitleLength": 40
	},
	"phonemode_inform": {
		"rangeMetres": 5,
		"rangeToleranceMetres": 2,
		"cooldownSeconds": 30,
		"revealNames": true,
		"requireConsent": true,
		"allowExchange": true,
		"requestSeconds": 60
	},
	"phonemode_locations": {
		"enabled": true,
		"markerSeconds": 0,
		"arrivalMetres": 10
	},
	"phonemode_calls": {
		"enabled": true,
		"ringSeconds": 30,
		"logSize": 50,
		"rateLimitCount": 4,
		"rateLimitWindowMs": 30000,
		"ringtones": [
			{
				"id": "hoot",
				"label": "Owl Hoot",
				"file": "Sounds/OwlHoot.wav"
			},
			{
				"id": "chime",
				"label": "Bell Chime",
				"file": "Sounds/BellChime.wav"
			},
			{
				"id": "harp",
				"label": "Enchanted Harp",
				"file": "Sounds/EnchantedHarp.wav"
			}
		],
		"defaultRingtone": "hoot",
		"voiceEnabled": true,
		"voiceBitrate": 24000
	},
	"phonemode_effects": {
		"enabled": true,
		"muggle": {
			"keyTap": "Sounds/Phone/KeyTap.wav",
			"keyEraseTap": "Sounds/Phone/KeyEraseTap.wav",
			"appTap": "Sounds/Phone/AppTap.wav",
			"lock": "Sounds/Phone/Lock.wav",
			"unlock": "Sounds/Phone/Unlock.wav",
			"messageSent": "Sounds/Phone/MessageSent.wav",
			"messageReceived": "Sounds/Phone/MessageReceived.wav"
		},
		"parchment": {
			"keyTap": "Sounds/Parchment/KeyTap.wav",
			"keyEraseTap": "Sounds/Parchment/KeyEraseTap.wav",
			"appTap": "Sounds/Parchment/AppTap.wav",
			"lock": "Sounds/Parchment/Lock.wav",
			"unlock": "Sounds/Parchment/Unlock.wav",
			"messageSent": "Sounds/Parchment/MessageSent.wav",
			"messageReceived": "Sounds/Parchment/MessageReceived.wav"
		}
	},
	"phonemode_ui": {
		"scale": 1.0,
		"widthPx": 360,
		"heightPx": 700,
		"rightMarginPx": 32,
		"defaultTheme": "muggle",
		"allowMove": false,
		"lockScreen": true,
		"bannerDurationMs": 4000
	},
	"immersivemode_readmode": "free",
	"immersivemode_writemode": "free",
	"immersivemode_letters": {
		"maxLength": 4000,
		"maxLines": 150,
		"maxRecipients": 8
	},
	"immersivemode_posts": [],
	"immersivemode_postadmin": {
		"capability": "admin.view",
		"fallbackGroup": "admin",
		"fallbackMinimumGrade": 1
	},
	"immersivemode_avatars": false,
	"immersivemode_ui": {
		"scale": 1.0
	}
}
