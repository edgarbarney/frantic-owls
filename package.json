{
	"name": "frantic-owls",
	"version": "0.1.0",
	"author": "FranticDreamer",
	"license": "BSD-3-Clause",
	"homepage": "https://github.com/edgarbarney",
	"description": "Frantic's Wizarding Communication: a pseudo-smartphone with contacts and owl messaging for HogwartsMP.",
	"private": true,
	"mafiahub": {
		"serverScripts": [
			"Server/Main.js"
		],
		"clientScripts": [
			"Client/Main.js"
		],
		"files": [
			"Client/Main.js",
			"UI/**"
		],
		"exports": [
			"status",
			"api"
		],
		"resourceDependencies": [
			{
				"name": "hmp-lib",
				"version": "0.9.0"
			},
			{
				"name": "hmp-mysql",
				"version": "0.9.0"
			},
			{
				"name": "hmp-core",
				"version": "0.9.0"
			},
			{
				"name": "hmp-admin",
				"version": "0.9.0",
				"optional": true
			},
			{
				"name": "hmp-webhooks",
				"version": "0.9.0",
				"optional": true
			},
			{
				"name": "hmp-blips",
				"version": "0.9.0",
				"optional": true
			},
			{
				"name": "hmp-activities",
				"version": "0.9.0",
				"optional": true
			}
		],
		"errorBehavior": "stop"
	}
}
